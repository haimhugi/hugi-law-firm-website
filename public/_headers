# Cloudflare Workers Static Assets headers. Applies only to files served as static assets,
# not to responses generated by Worker code.
#
# Adding any third-party script, font, image or analytics requires updating this CSP and the privacy policy.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files are fingerprinted, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the Cloudflare preview addresses out of search results; only the real domain is indexed.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex
